# Copy to .env (never commit .env). Home Assistant long-lived token: Profile → Security → Long-lived access tokens.
HOMEASSISTANT_URL=http://192.168.1.77
HOMEASSISTANT_TOKEN=

# Away from home (Tailscale name or 100.x address of the NUC, see docs/remote_access_setup.md).
# Swap HOMEASSISTANT_URL to this value when remote, and use HA_SSH_HOST for tools/deploy.sh.
HOMEASSISTANT_URL_REMOTE=
HA_SSH_HOST=root@192.168.1.77
